# Backend API (Spring Boot). Auth is backend-owned: the frontend redirects to
# this origin for Google OAuth and calls /api/v1/auth/* for refresh/logout.
# Must match the backend port and the backend's FRONTEND_URL / CORS origin.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# Payments / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
