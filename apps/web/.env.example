# Backend API (Spring Boot). Auth is backend-owned: the frontend redirects to
# this origin for Google OAuth and calls /api/v1/auth/* for refresh/logout.
# Must match the backend port and the backend's FRONTEND_URL / CORS origin.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# Payments / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=

# Where the marketing Contact page sends demo requests and support mail (mailto:). Unset = the page says an address is coming.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Local development only: run the live interview room against a scripted mock interviewer
# (no API, LiveKit or AI service). Open /interviews/<any-id>/live while signed in.
NEXT_PUBLIC_LIVE_MOCK=0

# Local development only: copy and paste work natively in dev. Set 1 to turn the live room's clipboard rules on (blocked
# foreign pastes, the room clipboard) to test them. Production builds always enforce them.
NEXT_PUBLIC_ENFORCE_CLIPBOARD=0

# Shows the live room's "think aloud freely" note and the Ask interviewer button. Set "on" together with ADDRESSED_CHECK=on in the
# ai-service (the interviewer only stays quiet while the candidate thinks aloud in that mode). Anything else (default) hides both.
NEXT_PUBLIC_ADDRESSED_CHECK=off

# Dev deployment only: proxy /api/v1/* to the API so the browser stays same-origin (set NEXT_PUBLIC_API_URL="" with it).
# API_PROXY_TARGET=https://interviewiq-api.onrender.com
