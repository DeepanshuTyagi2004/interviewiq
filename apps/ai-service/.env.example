# Exa AI Search (brief generation source collection) — replaced Perplexity 2026-06-21
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=30.0
EXA_NUM_RESULTS=10               # results per query variant
EXA_TYPE=auto                    # neural | auto | fast | deep
EXA_USER_LOCATION=IN             # two-letter country code (geo-weights results)
# Allow-list: open web by default (leave empty). Optionally narrow (comma-separated), e.g.:
# EXA_INCLUDE_DOMAINS=ambitionbox.com,glassdoor.co.in,leetcode.com,reddit.com
EXA_INCLUDE_DOMAINS=
# Hosts dropped before extraction (content farms / listicles / job boards). Sent to Exa as
# excludeDomains AND re-applied locally. Comma-separated; setting this REPLACES the built-in
# default list. Leave unset to use defaults (see app/config.py).
# EXA_EXCLUDE_DOMAINS=prepfully.com,interviewquery.com,himalayas.app,scribd.com

# LLM (extract + aggregate) — OpenAI-compatible endpoint. Default provider: Google AI Studio (Gemma).
# Get an API key at https://aistudio.google.com/apikey . Free tier for Gemma 4 31B: RPM 15 · RPD 1,500 · TPM unlimited.
# Comma-separate multiple keys to multiply throughput: the client round-robins across them and
# rotates off any that 429s, waiting only when ALL keys are rate-limited. Same model on each, so each
# key has the same RPM → N keys ≈ N×RPM. One key is fine (no comma). e.g. LLM_API_KEY=key1,key2,key3
LLM_API_KEY=
# Exact AI Studio model id (bare, no "models/" prefix). Confirm the Gemma 4 31B id in AI Studio's
# model list; gemma-3-27b-it is the current public 27B if a 31B isn't listed for your key.
LLM_MODEL_NAME=gemma-3-27b-it
# Dedicated model for résumé parsing (onboarding). Reuses the same keys/round-robin client; leave
# blank to fall back to LLM_MODEL_NAME. Set to the Gemini Flash id you want, e.g. gemini-2.0-flash.
RESUME_LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 120s: Gemma 4 31B always "thinks" first, so calls are slow and the tail can pass 60s (ReadTimeout).
LLM_TIMEOUT_SECONDS=120.0
EXTRACT_MAX_SOURCES=40
# RPM 15 is the binding limit — keep low; the 429 handler paces bursts.
EXTRACT_CONCURRENCY=2
# Debug: store the model's <thought> reasoning (per-source extract + aggregate) in each brief doc
# so the admin UI can show it. Off in prod (keeps docs lean).
LLM_CAPTURE_THOUGHTS=false

# MongoDB
MONGODB_URL=
MONGODB_DB=interviewiq_intelligence

# Internal service-to-service auth (shared secret with interviewiq-api)
INTERNAL_API_KEY=

# interviewiq-api: source of the JD targets to generate briefs for
API_BASE_URL=http://interviewiq-api:8080

# Brief generation schedule
SCHEDULER_ENABLED=true
BRIEF_REFRESH_INTERVAL_DAYS=7
BRIEF_STALE_AFTER_DAYS=7
BRIEF_INTER_CALL_DELAY_SECONDS=2.0

# Question bank: live sources
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_LEETCODE_DATASET=gzipchrist/leetcode-problem-dataset
NEETCODE_REPO=dipjul/NeetCode-150
NEETCODE_REF=main
MACHINE_CODING_REPO=lavakumarThatisetti/Machine-Coding-Round
MACHINE_CODING_REF=master

# Langfuse tracing (OPTIONAL — off by default; the service runs without the `langfuse` package).
# Set LANGFUSE_ENABLED=true AND both keys to enable tracing spans.
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Logging
LOG_LEVEL=INFO

# Google Gemini (native generateContent API; a paid key). When set, every routed LLM call (research,
# question content, profile scoring, interview blueprints) tries Gemini first, then Groq -> Cloudflare -> LLM_*.
# Comma-separate several keys to rotate them. Tests never read this key (tests/conftest.py blanks it).
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=180
# Output budget per call (thinking tokens count against it); a larger caller cap wins.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Gemini 3 thinking level: low | medium | high; blank = the model's default (slower).
GEMINI_THINKING_LEVEL=low

# --- Company research pipeline (Intelligence → Companies / Runs) ---
# Groq: the free-tier chain after Gemini (first when GEMINI_API_KEY is empty). Empty skips Groq.
# Comma-separated keys (trimmed/deduplicated); try keys for each Groq model before LLM_* fallback.
# GROQ_API_KEY=<groq-key-one>,<groq-key-two>
GROQ_API_KEY=
# Official Groq production model: https://console.groq.com/docs/models
GROQ_MODEL_NAME=openai/gpt-oss-120b
# Optional local setup: 120b keys → 20b keys → Cloudflare (when configured) → Google LLM_*.
# Comma-separated ordered models (trimmed/deduplicated); unset/blank defaults to no extra models.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# Free plan for BOTH models: 30 RPM / 8K TPM / 1K RPD / 200K TPD.
# Organization-scoped limits may be shared; extra keys/models do not guarantee additive throughput
# or bypass quotas. Check your organization's limits: https://console.groq.com/docs/rate-limits
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Per-request timeout for Groq; fallback keeps LLM_TIMEOUT_SECONDS.
GROQ_TIMEOUT_SECONDS=30
# Optional research-only Workers AI fallback; set BOTH or leave BOTH blank to disable.
# Token needs Workers AI access for the account. Keep real values in the ignored local .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_NAME=@cf/openai/gpt-oss-120b
# Positive finite per-request timeout; output tokens capped conservatively at 1..24000 (128K context).
CLOUDFLARE_TIMEOUT_SECONDS=30
CLOUDFLARE_MAX_TOKENS=4096
# Free allocation: 10,000 neurons/day, resetting at 00:00 UTC. Paid-account overage is billed.
# Model beyond allocation: $0.35/M input tokens, $0.75/M output tokens. Not unlimited/free overage.
RESEARCH_ENABLED=true
# Weekly run (APScheduler crontab, Asia/Kolkata; use day NAMES). Only when SCHEDULER_ENABLED=true.
RESEARCH_CRON=0 2 * * mon
# live | record | replay. Local dev: record once, then replay for free, deterministic, offline runs.
RESEARCH_MODE=live
RESEARCH_FIXTURES_DIR=.research-fixtures
RESEARCH_CONCURRENCY=2
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_STALE_AFTER_DAYS=7
RESEARCH_MAX_ROLES=8
# Per-run caps; reaching one auto-pauses the run (raise in the UI, then Resume). Dev: 60 / 250.
RESEARCH_MAX_EXA_CALLS=400
RESEARCH_MAX_LLM_CALLS=2000
RESEARCH_MAX_ATTEMPTS=2
# Full-verbosity trace retention (events + payloads). The Atlas free tier (512 MB) fills past ~50 companies.
RESEARCH_TRACE_TTL_DAYS=14
# Run-wide concurrent Exa / LLM calls (cache hits are free). Keep LLM low for Groq free-tier rate limits.
RESEARCH_EXA_CONCURRENCY=2
RESEARCH_LLM_CONCURRENCY=4
# Research-only deadlines include provider queues; other workflows keep LLM_TIMEOUT_SECONDS.
RESEARCH_LLM_DEADLINE_SECONDS=75
RESEARCH_OPERATION_TIMEOUT_SECONDS=90
RESEARCH_GROQ_STAGE_SECONDS=25
RESEARCH_GOOGLE_TIMEOUT_SECONDS=12
RESEARCH_MAX_OUTPUT_TOKENS=2048
RESEARCH_GROQ_TPM=8000
# Profile scoring (item assessment + company context): Groq first (GROQ_MODEL_NAME, then
# GROQ_FALLBACK_MODELS), then Cloudflare, then Google. One call + one repair must stay under the
# API's 120s AI_SERVICE_TIMEOUT_MS.
PROFILE_SCORING_LLM_DEADLINE_SECONDS=50
PROFILE_SCORING_GROQ_STAGE_SECONDS=40
PROFILE_SCORING_MAX_OUTPUT_TOKENS=4096
RESEARCH_GROQ_RPM=30
RESEARCH_CHUNK_CHARS=4500
RESEARCH_MAX_CHUNKS=4
# Targeted follow-up searches per company for fields still empty after the main pass (0 = off).
RESEARCH_FOLLOWUP_MAX_QUERIES=6

# Interview blueprint (prep phase). Defaults are fine; see app/config.py.
# Groq's cap (its free tier's per-minute ledger needs ~3500); Gemini uses GEMINI_MAX_OUTPUT_TOKENS.
# BLUEPRINT_MAX_OUTPUT_TOKENS=3500
# BLUEPRINT_CONCURRENCY=4
# BLUEPRINT_MAX_PARALLEL_RUNS=3
# BLUEPRINT_TRANSIENT_RETRIES=2
# BLUEPRINT_RUN_TIMEOUT_SECONDS=900
# BLUEPRINT_RUN_RETENTION_DAYS=30
# BLUEPRINT_SELECTION_WEIGHTS=

# --- Live interviewer worker (python -m app.interviewer.worker dev) ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
DEEPGRAM_API_KEY=<deepgram-key>
OPENROUTER_API_KEY=<openrouter-key>
INTERVIEWER_TALKER_MODEL=deepseek/deepseek-v4.1-flash
INTERVIEWER_TALKER_REASONING=none
INTERVIEWER_DIRECTOR_MODEL=deepseek/deepseek-v4.1-flash
INTERVIEWER_DIRECTOR_REASONING=medium
# Deepgram Aura-2 voices (English, no Indian accent): aura-2-orpheus-en / aura-2-orion-en / aura-2-arcas-en (male),
# aura-2-athena-en / aura-2-electra-en / aura-2-callista-en (female). Indian-accented Flux voices also work:
# flux-naveen-en (male), flux-priya-en / flux-meena-en (female)
# Voice provider: sarvam (Bulbul v4 Flash, Indian English) or deepgram (the Aura/Flux voices below)
INTERVIEWER_TTS_PROVIDER=sarvam
SARVAM_API_KEY=<sarvam-key>
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=shubh_enhi_ads
SARVAM_FEMALE_TTS_VOICE=roopa_en_conversational
INTERVIEWER_TTS_VOICE=aura-2-orpheus-en
INTERVIEWER_FEMALE_TTS_VOICE=aura-2-athena-en
# Keep the candidates' speech out of Deepgram's model-improvement programme (set false to opt in)
DEEPGRAM_MIP_OPT_OUT=true
# Raced against the talker model when it is slow, and used by the director when its own model fails ("" = off)
INTERVIEWER_FALLBACK_MODEL=z-ai/glm-5.3-flash
INTERVIEWER_FALLBACK_REASONING=minimal
INTERVIEWER_TALKER_TIMEOUT_SECONDS=3
INTERVIEWER_TALKER_DEADLINE_SECONDS=32
# Dev: stop the worker when one of these stays unreachable for ~40 s (`pnpm dev` sets api, ai-service and web). Empty = never.
INTERVIEWER_STOP_WHEN_DOWN=
