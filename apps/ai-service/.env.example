# Perplexity API (brief generation)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_TIMEOUT_SECONDS=30.0

# Perplexity Search API (source collection)
# Open web by default (leave empty). Optionally narrow to specific sites (comma-separated), e.g.:
# PERPLEXITY_SEARCH_DOMAINS=ambitionbox.com,glassdoor.co.in,leetcode.com,jointaro.com,reddit.com
PERPLEXITY_SEARCH_DOMAINS=
PERPLEXITY_SEARCH_RECENCY=year
PERPLEXITY_SEARCH_CONTEXT_SIZE=high
PERPLEXITY_SEARCH_COUNTRY=IN
COLLECT_MAX_RESULTS=20

# Groq (extract + aggregate)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
# qwen3 reasoning suppression -> clean JSON + low tokens. qwen3-32b uses reasoning_format=hidden;
# reasoning_effort=none is qwen3.6-27b-only (leave empty for 32b).
GROQ_REASONING_FORMAT=hidden
GROQ_REASONING_EFFORT=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60.0
EXTRACT_MAX_SOURCES=40
EXTRACT_CONCURRENCY=8

# MongoDB
MONGODB_URL=
MONGODB_DB=interviewiq_intelligence

# Internal service-to-service auth (shared secret with interviewiq-api)
INTERNAL_API_KEY=

# interviewiq-api: source of the JD targets to generate briefs for
API_BASE_URL=http://interviewiq-api:8080

# Brief generation schedule
SCHEDULER_ENABLED=true
BRIEF_REFRESH_INTERVAL_DAYS=7
BRIEF_STALE_AFTER_DAYS=7
BRIEF_INTER_CALL_DELAY_SECONDS=2.0

# Logging
LOG_LEVEL=INFO
