    "problem": {
     "round_type": "dsa",
     "slug": "slug-core-1",
     "title": "Pair Sum",
     "difficulty": "medium",
     "content_hash": "h",
     "content": {
      "statement": "Given an array of integers nums and an integer target, solve pair sum.",
      "examples": [
       {
        "args": {
         "nums": [
          2,
          7,
          11,
          15
         ],
         "target": 9
        },
        "expected": [
         0,
         1
        ],
        "explanation": "2 + 7 = 9"
       },
       {
        "args": {
         "nums": [
          3,
          3
         ],
         "target": 6
        },
        "expected": [
         0,
         1
        ],
        "explanation": "3 + 3 = 6"
       }
      ],
      "constraints": [
       "2 <= len(nums) <= 10^4",
       "exactly one answer"
      ],
      "input_format": "nums: list[int], target: int",
      "output_format": "list[int] of two indices",
      "patterns": [
       "hash map"
      ]
     }
    },
    "answer_key": {
     "key": {
      "approaches": [
       {
        "name": "Brute force",
        "idea": "check every pair",
        "time_complexity": "O(n^2)",
        "space_complexity": "O(1)"
       },
       {
        "name": "One pass",
        "idea": "remember each value's index",
        "time_complexity": "O(n)",
        "space_complexity": "O(n)"
       }
      ],
      "complexity_target": "O(n) time",
      "key_insights": [
       "look up the complement",
       "one pass is enough"
      ],
      "common_wrong_paths": [
       {
        "path": "sorting first",
        "why_wrong": "loses the indices",
        "nudge": "What happens to the indices?"
       }
      ],
      "edge_cases": [
       "duplicates",
       "negative numbers"
      ],
      "reference_solution": {
       "language": "python",
       "entry_point": "pair_sum",
       "code": "def pair_sum(nums, target):\n    seen = {}\n    for i, x in enumerate(nums):\n        if target - x in seen:\n            return [seen[target - x], i]\n        seen[x] = i\n"
      }
     }
    },
    "ask": {
     "opening": "Let's work on a problem about pair sum.",
     "clarifications": [
      {
       "question": "Can values repeat?",
       "answer": "Yes."
      }
     ]
    },
    "hint_ladder": [
     {
      "step": 1,
      "hint": "What do you need to remember as you scan?"
     },
     {
      "step": 2,
      "hint": "A lookup structure could help."
     },
     {
      "step": 3,
      "hint": "Store each value's index as you go."
     }
    ],
