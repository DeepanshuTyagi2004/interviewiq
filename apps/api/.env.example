# interviewiq-api — copy to apps/api/.env for running the API directly on the host
# (`pnpm --filter @interviewiq/api dev`). .env is gitignored and loaded by the npm scripts.
# Start the local databases first: `pnpm db:up` (from the repo root).

PORT=8080
LOG_LEVEL=info

# --- Postgres: local container in dev, Supabase in production ---
DATABASE_URL=postgres://interviewiq:change-me-postgres@localhost:5432/interviewiq
# Supabase (session pooler):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# auto = honour ?sslmode=, else TLS for *.supabase.co/com hosts, else plain TCP.
DATABASE_SSL=auto
# Apply pending migrations at startup (replaces Hibernate ddl-auto=update).
DATABASE_MIGRATE_ON_START=true

# --- MongoDB: local container in dev, Atlas in production ---
MONGODB_URI=mongodb://interviewiq:change-me-mongo@localhost:27017/?authSource=admin
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=interviewiq
MONGODB_DATABASE=interviewiq

# --- Auth (reuse the Spring backend's values so existing sessions/tokens stay valid) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
JWT_SECRET=<at-least-32-byte-secret>
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
FRONTEND_CONNECTIONS_REDIRECT=http://localhost:3000/connections
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_EMAILS=

# --- GitHub OAuth App (Profile Builder) ---
GITHUB_OAUTH_CLIENT_ID=<github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_TOKEN_KEY=<base64-32-byte-key>

# --- interviewiq-ai-service ---
AI_SERVICE_BASE_URL=http://localhost:8000
INTERNAL_API_KEY=<shared-internal-api-key>

# --- LiveKit ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
