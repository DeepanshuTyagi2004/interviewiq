# interviewiq-backend environment — copy to .env and fill in.
# .env is gitignored and auto-imported by application.properties.
# (The full cross-service template lives in interviewiq-infra/.env.example.)

# --- Postgres (Supabase session pooler -> JDBC) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require&stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<password>

# --- Google OAuth2 (login) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# --- JWT signing secret ---
JWT_SECRET=<base64-hmac-secret>

# --- Frontend origin (CORS + OAuth redirect) ---
FRONTEND_URL=http://localhost:3000
FRONTEND_CONNECTIONS_REDIRECT=http://localhost:3000/connections

# --- GitHub OAuth App (Profile Builder) ---
GITHUB_OAUTH_CLIENT_ID=<github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<github-oauth-client-secret>
# AES-256-GCM key, base64 of 32 bytes, for encrypting stored GitHub tokens.
GITHUB_TOKEN_KEY=<base64-32-byte-key>

# --- interviewiq-ai-service (interview intelligence) ---
# Base URL of the Python AI service this backend fetches interview briefs from.
AI_SERVICE_BASE_URL=http://localhost:8000
# Shared secret presented to (and required by) interviewiq-ai-service. Must match
# INTERNAL_API_KEY in the AI service. Required — the app fails fast if unset.
INTERNAL_API_KEY=<shared-internal-api-key>

# --- Admin bootstrap (comma-separated emails auto-promoted to ADMIN on login) ---
ADMIN_EMAILS=
