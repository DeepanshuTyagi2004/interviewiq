# =============================================================================
# interviewiq local stack — copy to infra/.env and fill in:  cp infra/.env.example infra/.env
# One file feeds every service in infra/docker-compose.yml (env_file: .env) and compose's
# ${...} interpolation. Never commit the filled-in .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Local database containers (dev). Production uses Supabase (Postgres) + MongoDB Atlas —
# set DATABASE_URL / MONGODB_URI / MONGODB_URL below to point the stack at them instead.
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=interviewiq
MONGO_ROOT_PASSWORD=change-me-mongo
# The AI service's database name (the API uses MONGODB_DATABASE, default `interviewiq`).
MONGO_DB=interviewiq_intelligence

POSTGRES_USER=interviewiq
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=interviewiq

# -----------------------------------------------------------------------------
# Managed databases (OPTIONAL here — leave unset to use the local containers)
# -----------------------------------------------------------------------------
# Supabase Postgres for the API. Use the session pooler (port 5432) or the direct connection.
# TLS is enabled automatically for *.supabase.co/com hosts (DATABASE_SSL=auto).
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=auto            # auto | disable | require | verify-full
# DATABASE_SSL_CA=             # path to Supabase's CA .crt when DATABASE_SSL=verify-full

# MongoDB Atlas for the API's documents (candidate profiles, profile fragments, session outcomes).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=interviewiq
# MONGODB_DATABASE=interviewiq
# MongoDB Atlas for the AI service (same cluster is fine — separate database via MONGO_DB).
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interviewiq_intelligence?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Internal service-to-service shared secret (api <-> ai-service). Same value on both sides.
# Generate: `openssl rand -hex 32`
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=change-me-internal-key

# -----------------------------------------------------------------------------
# interviewiq-api — auth
# -----------------------------------------------------------------------------
# Google OAuth client. Authorized redirect URI: {API_PUBLIC_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HS256 signing secret, >= 32 bytes. Keep the old backend's value so existing sessions stay valid.
JWT_SECRET=
# Public origin of the API (builds the Google + GitHub OAuth redirect URIs).
API_PUBLIC_URL=http://localhost:8080
# Frontend origin (CORS + post-login redirect) and the connections page.
FRONTEND_URL=http://localhost:3000
FRONTEND_CONNECTIONS_REDIRECT=http://localhost:3000/connections
# Set true behind HTTPS. Use COOKIE_SAME_SITE=none (+ secure) when web and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated emails auto-promoted to ADMIN on Google login (bootstrap the first admin).
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# interviewiq-api — GitHub OAuth App (Profile Builder)
# Callback URL: {API_PUBLIC_URL}/api/v1/connections/github/callback
# -----------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# AES-256-GCM key (base64 of 32 bytes) for stored GitHub tokens. Keep the old backend's value.
# Generate: `openssl rand -base64 32`
GITHUB_TOKEN_KEY=

# -----------------------------------------------------------------------------
# interviewiq-api — LiveKit (live interview)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# interviewiq-api — interview blueprint prep (optional; defaults shown)
# -----------------------------------------------------------------------------
# SCHEDULER_ENABLED=true
# BLUEPRINT_RECONCILE_INTERVAL_MS=60000
# BLUEPRINT_REFRESH_EVERY_TICKS=15
# BLUEPRINT_REFRESH_CUTOFF_MINUTES=30
# BLUEPRINT_RUN_TIMEOUT_MINUTES=12
# BLUEPRINT_RETRY_LIMIT_PER_HOUR=3
# Off until the live interviewer is rebuilt on the blueprint.
# LIVE_INTERVIEWER_AVAILABLE=false

# Profile scoring beta is independently scheduled. UTC Monday weekly generations,
# startup catch-up and hourly due checks. No provider/collection calls from this job.
# PROFILE_SCORING_SCHEDULER_ENABLED=true

# -----------------------------------------------------------------------------
# interviewiq-ai-service — LLM + search (see apps/ai-service/.env.example for the full list)
# The LLM runs on the HOST or a hosted OpenAI-compatible endpoint. From inside Docker,
# 127.0.0.1 is the container — use host.docker.internal for a host-run server.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://host.docker.internal:1234
LLM_MODEL_NAME=google/gemma-4-e4b
RESUME_LLM_MODEL=
# LLM_API_KEY=
# EXA_API_KEY=

# --- Company research pipeline (Intelligence → Companies / Runs) ---
# RESEARCH_ENABLED=true
# Weekly run (APScheduler crontab, Asia/Kolkata; use day NAMES). Only when SCHEDULER_ENABLED=true.
# RESEARCH_CRON=0 2 * * mon
# live | record | replay. Local dev: record once, then replay for free, deterministic, offline runs.
# RESEARCH_MODE=live
# RESEARCH_FIXTURES_DIR=.research-fixtures
# RESEARCH_CONCURRENCY=2
# RESEARCH_RESULTS_PER_QUERY=5
# RESEARCH_STALE_AFTER_DAYS=7
# RESEARCH_MAX_ROLES=8
# Per-run caps; reaching one auto-pauses the run (raise in the UI, then Resume). Dev: 60 / 250.
# RESEARCH_MAX_EXA_CALLS=400
# RESEARCH_MAX_LLM_CALLS=2000
# RESEARCH_MAX_ATTEMPTS=2
# Full-verbosity trace retention (events + payloads). The Atlas free tier (512 MB) fills past ~50 companies.
# RESEARCH_TRACE_TTL_DAYS=14

# -----------------------------------------------------------------------------
# interviewiq-web (Next.js) — NEXT_PUBLIC_* are baked in at build time
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
