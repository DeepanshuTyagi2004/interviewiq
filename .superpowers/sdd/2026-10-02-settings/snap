#!/usr/bin/env bash
# Snapshot the working tree (scoped paths) into the plan's shadow git; prints the snapshot SHA.
# The real repo's index, HEAD and history are never touched.
set -euo pipefail
REPO=/Users/salescode/Desktop/project/interviewiq
SG="git --git-dir=$REPO/.superpowers/sdd/2026-10-02-settings/shadow.git --work-tree=$REPO"
cd "$REPO"
PATHS=(apps/api/src apps/api/test apps/api/drizzle apps/ai-service/app apps/ai-service/tests packages/contracts apps/web/app apps/web/components apps/web/features apps/web/lib apps/web/types apps/web/vitest.setup.ts apps/web/tailwind.config.js)
$SG add -A -- "${PATHS[@]}" >/dev/null 2>&1
$SG commit -q --allow-empty -m "${1:-snapshot}" >/dev/null
$SG rev-parse --short HEAD
