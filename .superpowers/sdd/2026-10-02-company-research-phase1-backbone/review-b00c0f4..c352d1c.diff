+        await store.insert_run(_run_doc("new", status="paused", created_at=T0 + timedelta(minutes=1)))
+        assert (await store.find_active_run())["run_id"] == "new"
+        listed = await store.list_runs(10)
+        assert [r["run_id"] for r in listed] == ["new", "old"]
